{
  "name": "montage",
  "version": "0.1.0",
  "private": true,
  "description": "Atelier vidéo : HyperFrames (HTML → vidéo), Remotion (React → vidéo) et FFmpeg (montage / encodage).",
  "workspaces": [
    "hyperframes",
    "remotion"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "doctor": "bash scripts/doctor.sh",
    "verify": "bash scripts/verify.sh",
    "brand:check": "python3 scripts/check-brand.py",
    "install:ai": "bash scripts/install-ai.sh",
    "hf:dev": "npm run dev -w montage-hyperframes",
    "hf:check": "npm run check -w montage-hyperframes",
    "hf:render": "npm run render -w montage-hyperframes",
    "remotion:dev": "npm run dev -w montage-remotion",
    "remotion:render": "bash scripts/with-browser.sh npm run render -w montage-remotion",
    "montage": "bash scripts/montage.sh",
    "tts": "bash -c 'cd hyperframes && npx hyperframes tts \"$@\"' --",
    "transcribe": "bash -c 'cd hyperframes && npx hyperframes transcribe \"$@\"' --",
    "voix:install": "bash scripts/install-voice.sh",
    "voix": "/root/.venvs/voice/bin/python scripts/voix.py",
    "fx:assets": "bash scripts/make-fx-assets.sh",
    "fx:localize": "python3 scripts/fx-localize.py",
    "grade": "bash scripts/grade.sh",
    "transition": "bash scripts/transition.sh"
  }
}
